{% if is_seed_data %}
<div style="background:#dc2626;color:#fff;text-align:center;padding:10px;font-size:13px;font-weight:bold;margin-bottom:16px;">
  ⚠ DEMO DATA — FICTIONAL COMPANIES — NOT FOR SUBMISSION TO SEBI
</div>
{% endif %}

<table style="width:100%;border-bottom:2px solid #16a34a;margin-bottom:16px;padding-bottom:8px">
  <tr>
    <td>
      <div style="font-size:18px;font-family:Georgia,serif;color:#16a34a;font-weight:600">praxya</div>
      <div style="font-size:9px;color:#64748b;letter-spacing:1px">BRSR COMPLIANCE PLATFORM</div>
    </td>
    <td style="text-align:right;font-size:10px;color:#64748b">
      <strong>{{ organisation_name }}</strong><br>
      {{ facility_name }} · {{ fy_label }}<br>
      Generated: {{ reporting_date }}
    </td>
  </tr>
</table>

<h2 style="font-family:Georgia,serif;font-size:15px;color:#1e293b;margin:0 0 4px 0">
  BRSR Section C — Principle 9: Business Responsibility Report
</h2>
<p style="font-size:10px;color:#64748b;margin:0 0 16px 0">
  KPI 1 — GHG Footprint · KPI 3 — Energy Footprint
</p>

<h3 style="font-family:Georgia,serif;font-size:13px;color:#1e293b;border-left:3px solid #16a34a;padding-left:8px;margin-bottom:8px">
  KPI 1 — GHG Footprint (SEBI BRSR Core)
</h3>
<table style="width:100%;border-collapse:collapse;margin-bottom:20px">
  <thead>
    <tr style="background:#f8fafc">
      <th style="padding:8px 10px;border:1px solid #e2e8f0;text-align:left;font-size:10px;color:#475569">Emission Category</th>
      <th style="padding:8px 10px;border:1px solid #e2e8f0;text-align:right;font-size:10px;color:#475569">Quantity (tCO₂e)</th>
      <th style="padding:8px 10px;border:1px solid #e2e8f0;text-align:right;font-size:10px;color:#475569">Intensity (tCO₂e/tonne)</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;">Scope 1 — Chemical Process Emissions</td>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;text-align:right">
        {{ "%.2f"|format(kpi1.scope1_process_tco2e or 0) }}
      </td>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;text-align:right">—</td>
    </tr>
    <tr style="background:#f8fafc">
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;">Scope 1 — Fuel Combustion</td>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;text-align:right">
        {{ "%.2f"|format(kpi1.scope1_combustion_tco2e or 0) }}
      </td>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;text-align:right">—</td>
    </tr>
    <tr>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;">Scope 2 — Grid Electricity</td>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;text-align:right">
        {{ "%.2f"|format(kpi1.scope2_tco2e or 0) }}
      </td>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;text-align:right">—</td>
    </tr>
    <tr style="background:#f0fdf4;font-weight:bold">
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;">TOTAL GHG Emissions</td>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;text-align:right;color:#16a34a">
        {{ "%.2f"|format(kpi1.total_tco2e or 0) }}
      </td>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;text-align:right">
        {% if kpi1.ghg_intensity_tco2e_per_tonne %}
          {{ "%.4f"|format(kpi1.ghg_intensity_tco2e_per_tonne) }}
        {% else %}—{% endif %}
      </td>
    </tr>
  </tbody>
</table>

<h3 style="font-family:Georgia,serif;font-size:13px;color:#1e293b;border-left:3px solid #16a34a;padding-left:8px;margin-bottom:8px">
  KPI 3 — Energy Footprint (SEBI BRSR Core)
</h3>
<table style="width:100%;border-collapse:collapse;margin-bottom:8px">
  <thead>
    <tr style="background:#f8fafc">
      <th style="padding:8px 10px;border:1px solid #e2e8f0;text-align:left;font-size:10px;color:#475569">Energy Category</th>
      <th style="padding:8px 10px;border:1px solid #e2e8f0;text-align:right;font-size:10px;color:#475569">Total Energy (GJ)</th>
      <th style="padding:8px 10px;border:1px solid #e2e8f0;text-align:right;font-size:10px;color:#475569">Intensity (GJ/tonne)</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;">Total Energy Consumed</td>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;text-align:right;color:#16a34a">
        {{ "%.2f"|format(kpi3.total_energy_gj or 0) }}
      </td>
      <td style="padding:8px 10px;border:1px solid #e2e8f0;font-size:10px;text-align:right">
        {% if kpi3.energy_intensity_gj_per_tonne %}
          {{ "%.4f"|format(kpi3.energy_intensity_gj_per_tonne) }}
        {% else %}—{% endif %}
      </td>
    </tr>
  </tbody>
</table>

{% if has_unsupported_fuel %}
<p style="font-size:9px;color:#d97706;background:#fffbeb;border:1px solid #fde68a;padding:6px 8px;border-radius:4px;margin-top:8px">
  ⚠ Energy total may be incomplete — non-diesel fuel inputs excluded pending IPCC 2006 Vol 2 constant confirmation. CA review required.
</p>
{% endif %}

<div style="margin-top:16px">
  <strong style="font-size:10px">Source Documents:</strong>
  <ul style="font-size:9px;color:#64748b;margin:4px 0;padding-left:16px">
    {% for doc in source_documents %}
      <li>{{ doc }}</li>
    {% else %}
      <li>No source documents available.</li>
    {% endfor %}
  </ul>
</div>

<div style="border-top:1px solid #e2e8f0;margin-top:16px;padding-top:8px;font-size:8px;color:#94a3b8">
  <strong>Calculation Methodology:</strong><br>
  Scope 2: CEA Grid Emission Factor 0.716 tCO₂/MWh (Source: CEA/TPP/EE/2024 Table 2)<br>
  Scope 1 Combustion (Diesel): IPCC 2006 Guidelines Vol 2, Tables 2.2 + 2.3<br>
  Scope 1 Process: IPCC 2006 Guidelines Vol 3, process-specific emission factors<br>
  {{ calculation_methodology }}
</div>

{% if ca_partner_name %}
<div style="margin-top:8px;font-size:9px;color:#1e293b">
  <strong>Verified by:</strong> {{ ca_partner_name }}
  {% if ca_icai_number %}· ICAI Reg: {{ ca_icai_number }}{% endif %}
</div>
{% endif %}

<div style="position:fixed;bottom:0;left:0;right:0;border-top:1px solid #e2e8f0;padding:6px 18mm;font-size:8px;color:#94a3b8;display:flex;justify-content:space-between">
  <span>Generated by Praxya (praxya.in) · Confidential</span>
  <span>{{ organisation_name }} · {{ fy_label }}</span>
</div>

<style>
@page { size: A4; margin: 20mm 18mm 20mm 18mm; }
body { font-family: Arial, sans-serif; font-size: 11px; color: #1e293b; line-height: 1.5; background-color: #ffffff; }
</style>
